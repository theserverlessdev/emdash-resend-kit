# Copy this file to .env and fill in the values. Do not commit .env.

# Resend API key. Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Signing secret of the Resend webhook. It starts with whsec_.
RESEND_WEBHOOK_SECRET=

# EmDash needs this key to store a secret in the admin settings.
# Create one with: npx emdash secrets generate
EMDASH_ENCRYPTION_KEY=
